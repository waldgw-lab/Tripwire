modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "source-search"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "intake-safety"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "claims-browser"

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "source-search"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts exec tsx --test source-search.test.mjs tripwire-priority.test.mjs live-claims.test.mjs"

[[workflows.workflow]]
name = "intake-safety"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts exec tsx --test tripwire-import-concurrency.test.mjs tripwire-import-matching.test.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "claims-browser"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run test:claims-browser"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
TRIPWIRE_EXTRACTION_MAX_CALL_MICROS = "100000"
TRIPWIRE_EXTRACTION_MODEL = "openai/gpt-5.4-mini"
TRIPWIRE_EXTRACTION_PROVIDER = "openrouter"
