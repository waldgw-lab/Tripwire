{
  "name": "@workspace/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx --tsconfig ../artifacts/tripwire/tsconfig.json --test ./*.test.mjs",
    "test:claims-browser": "playwright test --config browser/playwright.config.mjs",
    "test:reporting-safety": "tsx --test claim-policy-compatibility.test.mjs feed-refresh-history.test.mjs retained-content-guard.test.mjs retained-comparison.test.mjs tripwire-import-concurrency.test.mjs live-claims.test.mjs source-search.test.mjs",
    "hello": "tsx ./src/hello.ts",
    "source-search:inventory": "python ./source-search-inventory.py",
    "source-search:backfill": "tsx ./source-search-backfill.mjs",
    "source-search:test": "tsx --test ./source-search.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "catalog:",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "drizzle-orm": "catalog:",
    "tsx": "catalog:"
  }
}
